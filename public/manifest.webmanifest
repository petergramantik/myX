{
  "name": "myX – potápěčský logbook",
  "short_name": "myX",
  "description": "Logbook ponorů s X-CCR a Shearwater Petrel 2/3",
  "lang": "cs",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b1626",
  "theme_color": "#0b1626",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "file", "accept": ["*/*", ".db", "application/octet-stream", "application/x-sqlite3", "application/vnd.sqlite3"] }] }
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
